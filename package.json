{
  "name": "mg-autotech-files",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/customer-uploader"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:customer-uploader": "npm run build --workspace apps/customer-uploader",
    "start": "next start",
    "check:payments": "node scripts/check-payment-env.js",
    "fixtures:ecu-intelligence": "tsx scripts/generate-ai-training-fixtures.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:ecu-intelligence": "tsx --test tests/ecu-intelligence.test.ts",
    "typecheck": "npm run typecheck:web && npm run typecheck:customer-uploader",
    "typecheck:web": "tsc --noEmit -p tsconfig.json",
    "typecheck:customer-uploader": "npm run typecheck --workspace apps/customer-uploader",
    "lint": "eslint"
  },
  "dependencies": {
    "@supabase/auth-js": "^2.110.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "^16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.14.0",
    "stripe": "^22.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}

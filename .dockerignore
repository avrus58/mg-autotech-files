# in the builder context. They are not copied into the standalone runner.
tests/*
!tests/customer-workflow-client-bundles.test.ts
!tests/fixtures
tests/fixtures/*
!tests/fixtures/customer-workflow-route-closure
*.log
npm-debug.log*


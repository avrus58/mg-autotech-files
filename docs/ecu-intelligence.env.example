# Required existing server data access
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rule-based is safe and requires no model key.
AI_PROVIDER=rule_based
ENABLE_AI_TRAINING_DEMO=false

# Optional OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional self-hosted providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
VLLM_BASE_URL=
VLLM_MODEL=mg-autotech-ecu
VLLM_API_KEY=
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=mg-autotech-ecu
LOCAL_AI_API_KEY=

# Required for production File Expert analysis; optional only in local/test.
FILE_EXPERT_ANALYZER_URL=
FILE_EXPERT_ANALYZER_TOKEN=
# Required on the production Next.js project. Reuses the server-only Upstash/KV
# REST connection and caps analyzer work across all app instances.
FILE_EXPERT_ANALYZER_DISTRIBUTED_ADMISSION_ENABLED=true
FILE_EXPERT_ANALYZER_GLOBAL_CONCURRENCY=1
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Analyzer process only: comma-separated exact HTTPS signed-URL hosts.
FILE_EXPERT_ANALYZER_ALLOWED_HOSTS=

# Required existing server data access
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rule-based is safe and requires no model key.
AI_PROVIDER=rule_based
ENABLE_AI_TRAINING_DEMO=false

# Optional OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional self-hosted providers
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b
VLLM_BASE_URL=
VLLM_MODEL=mg-autotech-ecu
VLLM_API_KEY=
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=mg-autotech-ecu
LOCAL_AI_API_KEY=

# Optional external analyzer adapter
FILE_EXPERT_ANALYZER_URL=
